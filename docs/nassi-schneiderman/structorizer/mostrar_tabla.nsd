<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-26" preRepeat="hasta que " postFor="hasta" preReturn="devolver" postForIn="en" preWhile="mientras " output="ESCRIBIR" input="LEER" preFor="para" preExit="salir" preLeave="abandonar" ignoreCase="true" preThrow="lanzar" preForIn="para cada" stepFor="con paso" author="Grupo 2" created="2026-11-10" changedby="Grupo 2" changed="2026-11-10" origin="Structorizer 3.32-26" text="&#34;mostrar_tabla(r: ResultadoCaida, W: double, beta: double, g: double)&#34;" comment="&#34;Funcionalidad: imprimir la tabla t, v, x junto a v_analitica y x_analitica.&#34;,&#34;Entradas: r (tabla de filas), W [N], beta [N*s/m], g [m/s^2].&#34;,&#34;Salidas: ninguna (pantalla).&#34;" color="ffffff" type="sub" style="nice" include_list="tipos_y_constantes">
	<children>
		<instruction text="&#34;ESCRIBIR 't(s)', 'v(m/s)', 'x(m)', 'v_anal', 'x_anal'&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" rotated="0"></instruction>
		<for text="&#34;para k &#60;- 1 hasta r.n_filas&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" counterVar="k" startValue="1" endValue="r.n_filas" stepConst="1" style="COUNTER">
			<qFor>
				<instruction text="&#34;ESCRIBIR r.filas[k].t, r.filas[k].v, r.filas[k].x, v_analitica(r.filas[k].t, W, beta, g), x_analitica(r.filas[k].t, W, beta, g)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" rotated="0"></instruction>
				<alternative text="&#34;r.aterrizo and (k = r.n_filas)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qTrue>
						<instruction text="&#34;ESCRIBIR '   [suelo]'&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" rotated="0"></instruction>
					</qTrue>
					<qFalse>

					</qFalse>
				</alternative>
				<instruction text="&#34;ESCRIBIR fin de línea&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" rotated="0"></instruction>
			</qFor>
		</for>
	</children>
</root>
