<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-26" preRepeat="hasta que " postFor="hasta" preReturn="devolver" postForIn="en" preWhile="mientras " output="ESCRIBIR" input="LEER" preFor="para" preExit="salir" preLeave="abandonar" ignoreCase="true" preThrow="lanzar" preForIn="para cada" stepFor="con paso" author="Grupo 2" created="2026-11-10" changedby="Grupo 2" changed="2026-11-10" origin="Structorizer 3.32-26" text="&#34;registrar_fila(r: ResultadoCaida, t: double, v: double, x: double)&#34;" comment="&#34;Funcionalidad: agregar la fila (t, v, x) a la tabla de r.&#34;,&#34;Entradas: r (por referencia), t [s], v [m/s], x [m].&#34;,&#34;Salidas: r.filas y r.n_filas actualizados.&#34;" color="ffffff" type="sub" style="nice" include_list="tipos_y_constantes">
	<children>
		<alternative text="&#34;r.n_filas &#60; MAX_FILAS&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
			<qTrue>
				<instruction text="&#34;r.n_filas &#60;- r.n_filas + 1&#34;,&#34;r.filas[r.n_filas].t &#60;- t&#34;,&#34;r.filas[r.n_filas].v &#60;- v&#34;,&#34;r.filas[r.n_filas].x &#60;- x&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" rotated="0"></instruction>
			</qTrue>
			<qFalse>

			</qFalse>
		</alternative>
	</children>
</root>
