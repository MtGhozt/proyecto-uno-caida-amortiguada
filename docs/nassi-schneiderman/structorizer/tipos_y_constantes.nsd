<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-26" preRepeat="hasta que " postFor="hasta" preReturn="devolver" postForIn="en" preWhile="mientras " output="ESCRIBIR" input="LEER" preFor="para" preExit="salir" preLeave="abandonar" ignoreCase="true" preThrow="lanzar" preForIn="para cada" stepFor="con paso" author="Grupo 2" created="2026-11-10" changedby="Grupo 2" changed="2026-11-10" origin="Structorizer 3.32-26" text="&#34;tipos_y_constantes&#34;" comment="&#34;Constantes congeladas y registros compartidos por todos los módulos (ver docs/algoritmo.md).&#34;" color="ffffff" type="includable" style="nice">
	<children>
		<instruction text="&#34;const G &#60;- 9.81&#34;,&#34;const H_PASO &#60;- 0.1&#34;,&#34;const V_META &#60;- 20.0 / 9.0&#34;,&#34;const TOL_V &#60;- 0.05&#34;,&#34;const BETA_LO &#60;- 1.0&#34;,&#34;const Z_ESTABLE &#60;- 2.0&#34;,&#34;const MAX_ITER_BETA &#60;- 60&#34;,&#34;const IMPRIMIR_CADA &#60;- 50&#34;,&#34;const MAX_PASOS &#60;- 200000&#34;,&#34;const MAX_FILAS &#60;- MAX_PASOS div IMPRIMIR_CADA + 2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" rotated="0"></instruction>
		<instruction text="&#34;type Entrada = record{modo: int; masa_paracaidista: double; masa_impedimenta: double; altura: double; beta: double}&#34;,&#34;type Fila = record{t: double; v: double; x: double}&#34;,&#34;type ResultadoCaida = record{aterrizo: boolean; t_suelo: double; v_suelo: double; x_suelo: double; pasos: int; n_filas: int; filas: array of Fila}&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" rotated="0"></instruction>
	</children>
