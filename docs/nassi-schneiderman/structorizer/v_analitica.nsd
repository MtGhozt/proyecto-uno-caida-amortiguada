<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-26" preRepeat="hasta que " postFor="hasta" preReturn="devolver" postForIn="en" preWhile="mientras " output="ESCRIBIR" input="LEER" preFor="para" preExit="salir" preLeave="abandonar" ignoreCase="true" preThrow="lanzar" preForIn="para cada" stepFor="con paso" author="Grupo 2" created="2026-11-10" changedby="Grupo 2" changed="2026-11-10" origin="Structorizer 3.32-26" text="&#34;v_analitica(t: double, W: double, beta: double, g: double): double&#34;" comment="&#34;Funcionalidad: velocidad analítica v(t) = (W/beta)*(1 - exp(-beta*g*t/W)).&#34;,&#34;Entradas: t [s], W [N], beta [N*s/m], g [m/s^2].&#34;,&#34;Salida: v(t) [m/s].&#34;" color="ffffff" type="sub" style="nice" include_list="tipos_y_constantes">
	<children>
